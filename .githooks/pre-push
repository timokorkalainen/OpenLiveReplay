#!/usr/bin/env bash
# Pre-push hook: a FAST local pre-flight (~5 min). GitHub CI is now the
# comprehensive gate -- macOS + Linux + Windows builds, the unit suite, the
# playback e2e, and the clang ASan/UBSan/TSan sanitizer passes all run there (see
# .github/workflows/ci.yml). This hook just catches the COMMON failures before
# they reach CI, on the current platform:
#   * build the host (engine + app + test harnesses) with -Werror
#   * the transport x codec "delivery-gate" matrix (RTMP/SRT x h264/h265) --
#     local-only coverage CI does not run
#   * clang-tidy on changed first-party C++
#   * the fast unit label (-L ci)
#   * the GPU async-readback / AV-sync / device-loss / budget / seek-prefetch e2e selector
# A build / unit / clang-tidy failure blocks the push.
#
# A docs-only push -- one whose every changed file (vs merge-base with
# origin/main) is markdown, lives under docs/, or is root legal text
# (LICENSE/NOTICE/AUTHORS/COPYING) -- cannot affect the build, the delivery
# matrix, or any test, so the whole gate is auto-skipped (no Qt/ffmpeg needed).
# The check is fail-closed: ANY file outside that set runs the full gate.
#
# The heavier e2e + sanitizer + iOS gates are OPT-IN (OLR_PREPUSH_FULL=1) -- run
# them to reproduce a CI failure locally, or before a risky native/threading change.
#
# The gate HARD-FAILS the push if delivery tooling is missing (it does NOT
# silently skip): ffmpeg, ffprobe, srt-live-transmit, a Python 3, an H.264 and an
# HEVC encoder in ffmpeg, and the Qt host kit. Install on macOS with:
#   brew install ffmpeg srt
#
# Do NOT bypass this gate with `git push --no-verify` -- it is the project's
# required pre-flight. To skip a gate that cannot run on the current
# platform/toolchain, use the per-gate SKIP_* flags below.
#
# Triggers / flags:
#   git push                  -> build + delivery + clang-tidy + unit (BLOCKING default;
#                                auto-skipped for a docs-only push, see above)
#   OLR_PREPUSH_DOCS_FULL=1   -> force the full gate even for a docs-only push
#   OLR_PREPUSH_SKIP=1 push   -> emergency bypass ONLY (never use git push --no-verify;
#                                prefer the per-gate SKIP_* flags for platform skipping)
#   OLR_PREPUSH_LIGHT=1 push  -> delivery matrix ONLY (skip clang-tidy + unit)
#   SKIP_UNIT=1 / SKIP_TIDY=1 / SKIP_GPU_E2E=1  -> skip one default gate
#   OLR_PREPUSH_FULL=1 push   -> ALSO run e2e + ASan/UBSan + TSan + full CTest matrix + iOS
#                                (skip parts: SKIP_E2E=1 / SKIP_ASAN=1 / SKIP_TSAN=1 /
#                                 SKIP_FULL_TESTS=1 / SKIP_QT_MEDIA_SMOKE=1 /
#                                 SKIP_IOS_BUILD=1)
#
# Tunables:
#   OLR_E2E_CLIP_SECONDS  (default 5)               e2e / delivery clip length
#   QT_HOST_PREFIX        macOS Qt kit; auto-detected when unset (see below)
#   QT_IOS_PREFIX         iOS Qt kit; auto-detected when unset  (OLR_PREPUSH_FULL only)
#   OLR_QT_MEDIA_SMOKE_ALLOW_NO_AUDIO=1  permit a headless host with no audio device
#
# Enable the hook once per clone:  git config core.hooksPath .githooks
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if [ "${OLR_PREPUSH_SKIP:-0}" = "1" ]; then
    echo "[pre-push] OLR_PREPUSH_SKIP=1 - skipping the delivery gate. Push proceeding." >&2
    exit 0
fi

# --- Roadmap structural audit (runs for EVERY push, incl. docs-only) ----------
# The execution-model roadmap (docs/broadcast-plan/) is machine-checkable; a
# malformed plan must not reach CI. This is fast (python-only, < 1 s) and needs no
# Qt/ffmpeg, so it runs before the docs-only fast path and the tooling preflight.
# It is the same audit the required "Docs audit" CI job runs. Missing python is
# skipped (CI remains authoritative); a real audit failure BLOCKS the push.
if [ -f tools/roadmap/audit.py ]; then
    # Resolve a REAL Python 3 by executing a probe (mirrors have_python3 below) so
    # the Windows Store `python3` stub cannot masquerade as an interpreter.
    PP_PY=""
    for c in python3 python; do
        if command -v "$c" >/dev/null 2>&1 \
            && "$c" -c 'import sys; sys.exit(0 if sys.version_info[0] == 3 else 1)' >/dev/null 2>&1; then
            PP_PY="$c"; break
        fi
    done
    if [ -z "$PP_PY" ] && command -v py >/dev/null 2>&1 \
        && py -3 -c 'import sys; sys.exit(0 if sys.version_info[0] == 3 else 1)' >/dev/null 2>&1; then
        PP_PY="py -3"
    fi
    if [ -n "$PP_PY" ]; then
        echo "[pre-push] Roadmap audit (docs/broadcast-plan)..."
        $PP_PY tools/roadmap/audit.py || { echo "[pre-push] roadmap audit FAILED." >&2; exit 1; }
    else
        echo "[pre-push] python3 not found - skipping roadmap audit (CI enforces it)." >&2
    fi
fi

# --- 0. Docs-only fast path ---------------------------------------------------
# A push that touches ONLY documentation/legal text cannot affect the build, the
# delivery matrix, or any test, so the heavy gates below would validate nothing.
# Detect that case (fail-closed: ANY non-inert file -> full gate) and skip
# straight past the cold build -- before the tooling preflight, so a docs push
# needs no Qt/ffmpeg/srt. The cheap, file-scoped lints that apply to such a push
# still run here; for pure docs there are none today (clang-format/qmllint live
# in the pre-commit hook), so a new doc linter would slot in at the marker below.
# Force the full gate with OLR_PREPUSH_DOCS_FULL=1.
if [ "${OLR_PREPUSH_DOCS_FULL:-0}" != "1" ]; then
    # Mirror the clang-tidy gate's base resolution so "what's being pushed" is
    # measured the same way throughout the hook.
    docs_base="$(git merge-base HEAD origin/main 2>/dev/null \
                 || git rev-parse HEAD~1 2>/dev/null || git rev-parse HEAD 2>/dev/null || true)"
    docs_changed=""
    [ -n "$docs_base" ] && docs_changed="$(git diff --name-only "$docs_base" HEAD 2>/dev/null || true)"

    # Inert = markdown anywhere, the whole docs/ subtree, or root legal text.
    # NOTE: *.txt is deliberately NOT inert -- it would match CMakeLists.txt.
    is_inert_path() {
        case "$1" in
            *.md|docs/*|LICENSE*|NOTICE*|AUTHORS*|COPYING*) return 0 ;;
            *) return 1 ;;
        esac
    }

    docs_only=0
    if [ -n "$docs_changed" ]; then
        docs_only=1
        while IFS= read -r f; do
            [ -n "$f" ] || continue
            is_inert_path "$f" || { docs_only=0; break; }
        done <<< "$docs_changed"
    fi

    if [ "$docs_only" = "1" ]; then
        echo "[pre-push] Docs-only change (vs ${docs_base}) -- skipping build + delivery + unit + clang-tidy."
        echo "[pre-push] Changed files:"
        while IFS= read -r f; do
            [ -n "$f" ] && echo "[pre-push]   $f"
        done <<< "$docs_changed"
        # --- cheap doc-applicable lints would run here; none today ---
        echo "[pre-push] (OLR_PREPUSH_DOCS_FULL=1 forces the full gate.)"
        exit 0
    fi
fi

QT_VERSION="${QT_VERSION:-6.11.1}"

# Bash 3.2 / BSD-userland compatible natural selection for Qt installer kits.
olr_newest_qt_kit() {
    local suffix="$1"
    local kit version major minor patch key
    local best="" best_key=""
    for kit in "$HOME"/Qt/6.*/"$suffix"; do
        [ -d "$kit" ] || continue
        version="${kit%/$suffix}"
        version="${version##*/}"
        IFS=. read -r major minor patch <<< "$version"
        case "$major" in ''|*[!0-9]*) continue ;; esac
        case "$minor" in ''|*[!0-9]*) continue ;; esac
        case "$patch" in ''|*[!0-9]*) continue ;; esac
        key="$(printf '%09d%09d%09d' "$major" "$minor" "$patch")"
        if [ -z "$best_key" ] || [ "$key" \> "$best_key" ]; then
            best="$kit"
            best_key="$key"
        fi
    done
    printf '%s\n' "$best"
}

# Resolve the Qt kit prefixes portably so the gate runs on any machine without a
# hard-coded home path: an explicit override wins, then the same env vars the build
# honors (OLR_QT_ROOT / QT_ROOT_DIR), then Homebrew, then the newest online-installer
# kit, then Qt tools on PATH. Only the final literal is version-pinned (last resort).
olr_qt_host_prefix() {
    if [ -n "${QT_HOST_PREFIX:-}" ]; then printf '%s\n' "$QT_HOST_PREFIX"; return 0; fi
    if [ -n "${OLR_QT_ROOT:-}" ]; then printf '%s\n' "$OLR_QT_ROOT"; return 0; fi
    if [ -n "${QT_ROOT_DIR:-}" ]; then printf '%s\n' "$QT_ROOT_DIR"; return 0; fi
    local cand
    for cand in /opt/homebrew/opt/qt /usr/local/opt/qt; do
        if [ -d "$cand" ]; then printf '%s\n' "$cand"; return 0; fi
    done
    local newest
    newest="$(olr_newest_qt_kit macos)"
    if [ -n "$newest" ]; then printf '%s\n' "$newest"; return 0; fi
    local tool prefix
    for tool in qtpaths6 qtpaths qmake6 qmake; do
        if command -v "$tool" >/dev/null 2>&1; then
            case "$tool" in
                qtpaths*) prefix="$("$tool" --install-prefix 2>/dev/null || true)" ;;
                *) prefix="$("$tool" -query QT_INSTALL_PREFIX 2>/dev/null || true)" ;;
            esac
            if [ -n "$prefix" ] && [ -d "$prefix" ]; then printf '%s\n' "$prefix"; return 0; fi
        fi
    done
    printf '%s\n' "$HOME/Qt/$QT_VERSION/macos"
}
QT_HOST_PREFIX="$(olr_qt_host_prefix)"
CLIP_SECONDS="${OLR_E2E_CLIP_SECONDS:-5}"
DELIVERY_BUILD_DIR="${OLR_PREPUSH_DELIVERY_BUILD_DIR:-build/prepush-delivery}"

# --- 1. Preflight: hard-fail (block the push) if delivery tooling is missing ---
preflight_fail=0
note_missing() { echo "[pre-push] MISSING: $1" >&2; preflight_fail=1; }

for tool in ffmpeg ffprobe srt-live-transmit; do
    command -v "$tool" >/dev/null 2>&1 || note_missing "$tool not found on PATH"
done

# Python 3 SPECIFICALLY (mirror rtmp_lib.sh:rtmp_find_python3) -- a Python-2-only
# `python`/`py` would pass a bare presence check but make the RTMP cells SKIP.
have_python3() {
    local c
    for c in python3 python; do
        if command -v "$c" >/dev/null 2>&1 \
            && "$c" -c 'import sys; sys.exit(0 if sys.version_info[0] == 3 else 1)' >/dev/null 2>&1; then
            return 0
        fi
    done
    if command -v py >/dev/null 2>&1 \
        && py -3 -c 'import sys; sys.exit(0 if sys.version_info[0] == 3 else 1)' >/dev/null 2>&1; then
        return 0
    fi
    return 1
}
have_python3 || note_missing "Python 3 not found (needed by the RTMP fixture server)"

# Encoder checks need ffmpeg itself; skipped (ffmpeg already flagged above) if absent.
if command -v ffmpeg >/dev/null 2>&1; then
    ENCODERS="$(ffmpeg -hide_banner -encoders 2>/dev/null || true)"
    # H.264: the scripts accept only libx264 or h264_mf (see olr_h264_vcodec_args).
    if ! printf '%s\n' "$ENCODERS" | grep -Eq '(^|[[:space:]])(libx264|h264_mf)[[:space:]]'; then
        note_missing "no usable H.264 encoder (need libx264 or h264_mf) in ffmpeg"
    fi
    # HEVC: run_rtmp_hevc_smoke.sh only tries hevc_videotoolbox then libx265; the
    # SRT-HEVC cell accepts libx265 or any hevc_*. Require EITHER libx265 or
    # hevc_videotoolbox (an OR -- either one alone satisfies both cells); this is
    # the tightest check that still guarantees both HEVC cells run, never skip.
    if ! printf '%s\n' "$ENCODERS" | grep -Eq '(^|[[:space:]])(libx265|hevc_videotoolbox)[[:space:]]'; then
        note_missing "no usable HEVC encoder (need libx265 or hevc_videotoolbox) in ffmpeg"
    fi
fi

[ -d "$QT_HOST_PREFIX" ] || note_missing "Qt host kit not found at $QT_HOST_PREFIX"

if [ "$preflight_fail" -ne 0 ]; then
    cat >&2 <<EOF
[pre-push] Delivery gate cannot run -- required tooling is missing (see above).
[pre-push]   macOS install:  brew install ffmpeg srt
[pre-push]   Qt host kit:    set QT_HOST_PREFIX (currently $QT_HOST_PREFIX)
[pre-push] Emergency bypass: OLR_PREPUSH_SKIP=1 git push   (or git push --no-verify)
EOF
    exit 1
fi

# --- 2. Build the current-platform host (engine + app + test harnesses) -------
# -DOLR_WERROR=ON makes this the clang -Werror compile gate (mirrors what the
# macOS build-test CI job used to enforce); the same build dir is reused by the
# native unit/e2e and clang-tidy gates below.
echo "[pre-push] Building current-platform host in ${DELIVERY_BUILD_DIR}..."
    cmake -S . -B "$DELIVERY_BUILD_DIR" -G Ninja \
        -DCMAKE_BUILD_TYPE=Debug \
        -DCMAKE_PREFIX_PATH="$QT_HOST_PREFIX" \
        -DOLR_WERROR=ON \
        -DOLR_GPU_PIPELINE=ON \
        -DOLR_BUILD_TESTS=ON >/dev/null
cmake --build "$DELIVERY_BUILD_DIR"

# --- 3. Sanity: the delivery-gate label must resolve to exactly 4 cells --------
EXPECTED_CELLS=4
ACTUAL_CELLS="$(ctest --test-dir "$DELIVERY_BUILD_DIR" -L delivery-gate -N \
    | awk '/Total Tests:/ {print $NF}')"
if [ "${ACTUAL_CELLS:-0}" -ne "$EXPECTED_CELLS" ]; then
    echo "[pre-push] Delivery gate misconfigured: expected ${EXPECTED_CELLS} cells, found ${ACTUAL_CELLS:-0}." >&2
    exit 1
fi

# --- 4. Run the delivery matrix (RTMP/SRT x h264/h265) as a BLOCKING gate ------
echo "[pre-push] Running delivery matrix (clip=${CLIP_SECONDS}s) -- RTMP/SRT x h264/h265..."
OLR_E2E_CLIP_SECONDS="$CLIP_SECONDS" \
    ctest --test-dir "$DELIVERY_BUILD_DIR" -L delivery-gate \
        --output-on-failure --repeat until-pass:2 --no-tests=error
echo "[pre-push] Delivery matrix OK."

# Past here are the FAST pre-flight gates kept in the default push (~5 min) so
# PRs rarely fail CI on trivia: clang-tidy + the fast unit label on the build
# above. The slower e2e + sanitizer passes and the iOS build run in GitHub CI
# now -- opt into them locally with OLR_PREPUSH_FULL=1. OLR_PREPUSH_LIGHT=1 runs
# the delivery matrix only.
if [ "${OLR_PREPUSH_LIGHT:-0}" = "1" ]; then
    echo "[pre-push] OLR_PREPUSH_LIGHT=1 - delivery gate only; skipping clang-tidy + unit."
    exit 0
fi

QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-offscreen}"
export QT_QPA_PLATFORM

# Selectors kept verbatim so local == CI.
UNIT_SELECTOR_LE='sync-report|srt|native-apple-ingest|native-rtmp'
GPU_E2E_LABELS='async-readback|av-sync|device-loss|gpu-budget|seek-prefetch'
E2E_REGEX='^(e2e_record_stereo|e2e_record_mono|e2e_record_rational_fps|e2e_record_rational_fps_h264|e2e_play_storm|e2e_play_seekplay|e2e_play_armedcut|e2e_play_playlist)$'

# --- 5. Fast unit label (-L ci) on the build above -- catches the unit failures
# CI would catch, at native speed, in ~1 min.
if [ "${SKIP_UNIT:-0}" = "1" ]; then
    echo "[pre-push] SKIP_UNIT=1 - skipping the unit gate."
else
    echo "[pre-push] Running unit suite (native, -L ci)..."
    ctest --test-dir "$DELIVERY_BUILD_DIR" --output-on-failure --repeat until-pass:2 \
        -L ci -LE "$UNIT_SELECTOR_LE"
    echo "[pre-push] Unit suite OK."
fi

# --- 6. GPU regression e2e selector -- mirrors the GitHub GPU gate. -----------
if [ "${SKIP_GPU_E2E:-0}" = "1" ]; then
    echo "[pre-push] SKIP_GPU_E2E=1 - skipping GPU regression e2e."
else
    echo "[pre-push] Running GPU regression e2e (${GPU_E2E_LABELS})..."
    ctest --test-dir "$DELIVERY_BUILD_DIR" --output-on-failure --repeat until-pass:2 \
        --no-tests=error -L "$GPU_E2E_LABELS"
    echo "[pre-push] GPU regression e2e OK."
fi

# --- 7. clang-tidy on changed first-party C++ (was: build-test-macos clang-tidy) -
# Uses the delivery build's compile_commands.json. Pass 1 = whole changed file
# (config-driven WarningsAsErrors); Pass 2 = diff-scoped narrowing/widening gate.
# Skipped with a warning (not fatal) if LLVM clang-tidy is unavailable, matching
# the pre-commit hook's "partial toolchain does not block" policy.
if [ "${SKIP_TIDY:-0}" = "1" ]; then
    echo "[pre-push] SKIP_TIDY=1 - skipping clang-tidy gate."
else
    TIDY="$(command -v clang-tidy || true)"
    [ -x "$TIDY" ] || TIDY=/opt/homebrew/opt/llvm/bin/clang-tidy
    CTD="$(dirname "$TIDY")/../share/clang/clang-tidy-diff.py"
    if [ -x "$TIDY" ] && [ -f "$DELIVERY_BUILD_DIR/compile_commands.json" ]; then
        base="$(git merge-base HEAD origin/main 2>/dev/null \
                || git rev-parse HEAD~1 2>/dev/null || git rev-parse HEAD)"
        SDK="$(xcrun --show-sdk-path 2>/dev/null || true)"
        tidy_paths=('recorder_engine/*.cpp' 'playback/*.cpp' 'project/*.cpp'
                    'telemetry/*.cpp' 'websocket/*.cpp'
                    'settingsmanager.cpp' 'uimanager.cpp' 'midi/*.cpp')
        files="$(git diff --name-only "$base" HEAD -- "${tidy_paths[@]}" || true)"
        if [ -z "$files" ]; then
            echo "[pre-push] clang-tidy: no first-party C++ changes."
        else
            echo "[pre-push] Running clang-tidy on changed first-party C++..."
            printf '%s\n' "$files"
            rc=0
            tidy_extra_args=()
            diff_tidy_extra_args=()
            if [ -n "$SDK" ]; then
                tidy_extra_args+=(--extra-arg=-isysroot --extra-arg="$SDK")
                diff_tidy_extra_args+=(-extra-arg=-isysroot -extra-arg="$SDK")
            fi
            qt_gui_private_include="$QT_HOST_PREFIX/lib/QtGui.framework/Versions/A/Headers/$QT_VERSION/QtGui"
            if [ -d "$qt_gui_private_include" ]; then
                tidy_extra_args+=(--extra-arg="-I$qt_gui_private_include")
                diff_tidy_extra_args+=(-extra-arg="-I$qt_gui_private_include")
            fi
            # Pass 1 -- whole changed file (the high-signal bug classes are fatal).
            while IFS= read -r file; do
                [ -n "$file" ] || continue
                "$TIDY" -p "$DELIVERY_BUILD_DIR" "${tidy_extra_args[@]}" "$file" || rc=1
            done <<< "$files"
            # Pass 2 -- diff-scoped integer-coercion gate (NEW occurrences fatal).
            if [ -f "$CTD" ]; then
                git diff -U0 "$base" HEAD -- "${tidy_paths[@]}" \
                    | python3 "$CTD" -p1 -path "$DELIVERY_BUILD_DIR" -clang-tidy-binary "$TIDY" \
                        -checks='-*,cppcoreguidelines-narrowing-conversions,bugprone-implicit-widening-of-multiplication-result' \
                        -warnings-as-errors='*' "${diff_tidy_extra_args[@]}" || rc=1
            fi
            [ "$rc" -eq 0 ] || { echo "[pre-push] clang-tidy gate FAILED." >&2; exit 1; }
            echo "[pre-push] clang-tidy OK."
        fi
    else
        echo "[pre-push] clang-tidy skipped (no LLVM clang-tidy or compile_commands.json)." >&2
    fi
fi

# --- 8. OPT-IN heavy gates (OLR_PREPUSH_FULL): the e2e + sanitizer + iOS passes
# that GitHub CI now runs on every PR. Off by default to keep the push fast; run
# them to reproduce a CI failure locally or before a risky native/threading change.
if [ "${OLR_PREPUSH_FULL:-0}" != "1" ]; then
    exit 0
fi
echo "[pre-push] OLR_PREPUSH_FULL=1 - running e2e + sanitizers + full matrix + iOS."

# --- 8a. Isolated packaged Qt media runtime -----------------------------------
# The release bundle, not the developer Qt installation, is the contract: audit
# it first, then prove raw audio and application-fed video work without Qt's
# FFmpeg plugin. This remains opt-in with the other package/iOS-heavy checks.
if [ "${SKIP_QT_MEDIA_SMOKE:-0}" = "1" ]; then
    echo "[pre-push] SKIP_QT_MEDIA_SMOKE=1 - skipping packaged Qt media runtime smoke."
else
    RUNTIME_EVIDENCE_DIR="${OLR_QT_MEDIA_SMOKE_EVIDENCE_DIR:-macos_build/dist/runtime-evidence}"
    RUNTIME_SMOKE_ARGS=()
    if [ "${OLR_QT_MEDIA_SMOKE_ALLOW_NO_AUDIO:-0}" = "1" ]; then
        RUNTIME_SMOKE_ARGS+=(--allow-no-audio-device)
    fi
    export OLR_QT_ROOT="$QT_HOST_PREFIX"
    echo "[pre-push] Building and auditing the packaged Qt media runtime..."
    ./build-scripts/build_macos_app.sh
    cmake --preset macos-release -DOLR_BUILD_TESTS=ON >/dev/null
    cmake --build --preset macos-release --target qt_core_media_smoke
    RUNTIME_HARNESS="$REPO_ROOT/build/qt_core_media_smoke"
    [ -x "$RUNTIME_HARNESS" ] || {
        echo "[pre-push] $RUNTIME_HARNESS was not built or is not executable." >&2
        exit 1
    }
    mkdir -p "$RUNTIME_EVIDENCE_DIR"
    python3 tests/e2e/run_qt_core_media_smoke.py \
        --package build/OpenLiveReplay.app \
        --harness "$RUNTIME_HARNESS" \
        --platform macos \
        --controlled-prefix "ffmpeg=$REPO_ROOT/macos_build/dist/ffmpeg" \
        --controlled-prefix "srt=$REPO_ROOT/macos_build/dist/srt" \
        --evidence-dir "$RUNTIME_EVIDENCE_DIR" \
        "${RUNTIME_SMOKE_ARGS[@]}"
    echo "[pre-push] Packaged Qt media runtime smoke OK."
fi

# --- 7a. playback/record e2e at native speed (the native-timing scheduling run) -
if [ "${SKIP_E2E:-0}" = "1" ]; then
    echo "[pre-push] SKIP_E2E=1 - skipping native e2e."
else
    echo "[pre-push] Running playback e2e (native speed)..."
    OLR_E2E_CLIP_SECONDS="$CLIP_SECONDS" \
        ctest --test-dir "$DELIVERY_BUILD_DIR" --output-on-failure --repeat until-pass:3 \
            --no-tests=error -R "$E2E_REGEX"
    echo "[pre-push] Native e2e OK."
fi

# --- 7b. clang ASan+UBSan: unit + e2e (local repro of the CI sanitizers job) ----
# A separate -DOLR_SANITIZER build (cannot share the delivery binary). ASan/UBSan
# aborts are deterministic (abort_on_error/halt_on_error), so until-pass retries
# only paper over loopback timing flakes, never a real sanitizer finding.
if [ "${SKIP_ASAN:-0}" = "1" ]; then
    echo "[pre-push] SKIP_ASAN=1 - skipping ASan/UBSan gate."
else
    ASAN_BUILD_DIR="${OLR_PREPUSH_ASAN_BUILD_DIR:-build/prepush-asan}"
    echo "[pre-push] Building ASan+UBSan suite in ${ASAN_BUILD_DIR}..."
    cmake -S . -B "$ASAN_BUILD_DIR" -G Ninja \
        -DCMAKE_BUILD_TYPE=Debug \
        -DOLR_BUILD_TESTS=ON \
        -DOLR_GPU_PIPELINE=ON \
        -DOLR_WERROR=ON \
        -DOLR_SANITIZER="address;undefined" \
        -DCMAKE_PREFIX_PATH="$QT_HOST_PREFIX" >/dev/null
    cmake --build "$ASAN_BUILD_DIR"
    echo "[pre-push] Running unit suite under ASan+UBSan..."
    ASAN_OPTIONS="detect_leaks=0:abort_on_error=1" \
    UBSAN_OPTIONS="print_stacktrace=1:halt_on_error=1" \
        ctest --test-dir "$ASAN_BUILD_DIR" --output-on-failure --repeat until-pass:2 \
            -L unit -LE "$UNIT_SELECTOR_LE"
    echo "[pre-push] Running playback e2e under ASan+UBSan..."
    ASAN_OPTIONS="detect_leaks=0:abort_on_error=1" \
    UBSAN_OPTIONS="print_stacktrace=1:halt_on_error=1" \
    OLR_E2E_CLIP_SECONDS="$CLIP_SECONDS" \
        ctest --test-dir "$ASAN_BUILD_DIR" --output-on-failure --repeat until-pass:3 \
            --no-tests=error -R "$E2E_REGEX"
    echo "[pre-push] ASan+UBSan OK."
fi

# --- 7c. TSan: threading-sensitive playback/output cases -----------------------
if [ "${SKIP_TSAN:-0}" = "1" ]; then
    echo "[pre-push] SKIP_TSAN=1 - skipping TSan gate."
else
    TSAN_BUILD_DIR="${OLR_PREPUSH_TSAN_BUILD_DIR:-build/prepush-tsan}"
    TSAN_TARGETS=(tst_trackbuffer tst_audioframequeue tst_outputdispatcher
                  tst_outputruntime tst_commitgate tst_seekcoalescer tst_outputbusengine
                  tst_ndiingest
                  tst_gpufence tst_gpugeneration tst_evictionguard tst_stagingfence
                  tst_gpu_sync_stress tst_gpuframedata tst_gpureadbackring
                  tst_gpucompositor_stress
                  tst_asyncgpureadbacksink tst_iotargetsinkfactory
                  tst_gpuencodepump tst_streamworker_gpuencode tst_playbackworker)
    echo "[pre-push] Building TSan threading targets in ${TSAN_BUILD_DIR}..."
    cmake -S . -B "$TSAN_BUILD_DIR" -G Ninja \
        -DCMAKE_BUILD_TYPE=Debug \
        -DOLR_BUILD_TESTS=ON \
        -DOLR_GPU_PIPELINE=ON \
        -DOLR_SANITIZER="thread" \
        -DCMAKE_PREFIX_PATH="$QT_HOST_PREFIX" >/dev/null
    cmake --build "$TSAN_BUILD_DIR" --target "${TSAN_TARGETS[@]}"
    echo "[pre-push] Running threading tests under TSan..."
    TSAN_OPTIONS="halt_on_error=1:suppressions=$PWD/tests/tsan.suppressions.txt" \
        ctest --test-dir "$TSAN_BUILD_DIR" --output-on-failure --repeat until-pass:2 \
            -R '^(tst_trackbuffer|tst_audioframequeue|tst_outputdispatcher|tst_outputruntime|tst_commitgate|tst_seekcoalescer|tst_outputbusengine|tst_ndiingest|tst_gpufence|tst_gpugeneration|tst_evictionguard|tst_stagingfence|tst_gpu_sync_stress|tst_gpuframedata|tst_gpureadbackring|tst_gpucompositor_stress|tst_asyncgpureadbacksink|tst_iotargetsinkfactory|tst_gpuencodepump|tst_streamworker_gpuencode|tst_playbackworker)$'
    echo "[pre-push] TSan OK."
fi

# --- 7d. Full local CTest matrix (everything except the local-only labels) -----
if [ "${SKIP_FULL_TESTS:-0}" = "1" ]; then
    echo "[pre-push] SKIP_FULL_TESTS=1 - skipping full local CTest gate."
else
    TEST_BUILD_DIR="${OLR_PREPUSH_TEST_BUILD_DIR:-build/prepush-tests}"
    CTEST_JOBS="${CTEST_PARALLEL_LEVEL:-$(sysctl -n hw.ncpu 2>/dev/null || echo 2)}"

    echo "[pre-push] Running full local CTest gate in ${TEST_BUILD_DIR}..."
    cmake -S . -B "$TEST_BUILD_DIR" -G Ninja \
        -DCMAKE_BUILD_TYPE=Debug \
        -DCMAKE_PREFIX_PATH="$QT_HOST_PREFIX" \
        -DOLR_GPU_PIPELINE=ON \
        -DOLR_BUILD_TESTS=ON >/dev/null
    cmake --build "$TEST_BUILD_DIR"
    ctest --test-dir "$TEST_BUILD_DIR" --output-on-failure \
        --repeat until-pass:2 --parallel "$CTEST_JOBS" \
        -LE 'sync-report|srt|native-apple-ingest|output-soak|ndi-output'
    echo "[pre-push] Full local CTest gate OK."
fi

if [ "${SKIP_IOS_BUILD:-0}" = "1" ]; then
    echo "[pre-push] SKIP_IOS_BUILD=1 - skipping iOS build."
    exit 0
fi

# Locate the Qt iOS kit. Override via QT_IOS_PREFIX if your Qt lives elsewhere; by
# default it sits beside the resolved macOS kit, else the newest installed iOS kit.
olr_qt_ios_prefix() {
    if [ -n "${QT_IOS_PREFIX:-}" ]; then printf '%s\n' "$QT_IOS_PREFIX"; return 0; fi
    local sibling="${QT_HOST_PREFIX%/macos}/ios"
    if [ -d "$sibling" ]; then printf '%s\n' "$sibling"; return 0; fi
    local newest
    newest="$(olr_newest_qt_kit ios)"
    if [ -n "$newest" ]; then printf '%s\n' "$newest"; return 0; fi
    printf '%s\n' "$HOME/Qt/$QT_VERSION/ios"
}
QT_IOS_PREFIX="$(olr_qt_ios_prefix)"
QT_CMAKE="$QT_IOS_PREFIX/bin/qt-cmake"

if [ ! -x "$QT_CMAKE" ]; then
    echo "[pre-push] Qt iOS kit not found at $QT_IOS_PREFIX." >&2
    echo "[pre-push] Set QT_IOS_PREFIX, or use SKIP_IOS_BUILD=1 explicitly." >&2
    exit 1
fi

echo "[pre-push] Building iOS (FFmpeg deps cached in ios_build/xcframeworks; first run ~20 min)..."
BUILD_DIR="$REPO_ROOT/build/ios-prepush"
rm -rf "$BUILD_DIR"

env -u GIT_CONFIG -u GIT_CONFIG_GLOBAL -u GIT_CONFIG_SYSTEM -u GIT_CONFIG_COUNT \
    "$QT_CMAKE" -S . -B "$BUILD_DIR" -G Xcode \
    -DQT_HOST_PATH="$QT_HOST_PREFIX" \
    -DCMAKE_OSX_ARCHITECTURES=arm64 \
    -DOLR_GPU_PIPELINE=ON >/dev/null

if ! env -u GIT_CONFIG -u GIT_CONFIG_GLOBAL -u GIT_CONFIG_SYSTEM -u GIT_CONFIG_COUNT \
        cmake --build "$BUILD_DIR" --config Debug -- \
        CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO; then
    echo "[pre-push] iOS build FAILED - push aborted (SKIP_IOS_BUILD=1 to override)." >&2
    exit 1
fi

APP_BUNDLE_COUNT="$(find "$BUILD_DIR" -type d -name OpenLiveReplay.app -prune | wc -l | tr -d '[:space:]')"
if [ "$APP_BUNDLE_COUNT" -ne 1 ]; then
    echo "[pre-push] Expected exactly one iOS OpenLiveReplay.app, found $APP_BUNDLE_COUNT." >&2
    exit 1
fi
APP_BUNDLE="$(find "$BUILD_DIR" -type d -name OpenLiveReplay.app -prune -print -quit)"

LINK_MAP_COUNT="$(find "$BUILD_DIR" -type f -name 'OpenLiveReplay-LinkMap-*-arm64.txt' | wc -l | tr -d '[:space:]')"
if [ "$LINK_MAP_COUNT" -ne 1 ]; then
    echo "[pre-push] Expected exactly one iOS OpenLiveReplay link map, found $LINK_MAP_COUNT." >&2
    exit 1
fi
LINK_MAP="$(find "$BUILD_DIR" -type f -name 'OpenLiveReplay-LinkMap-*-arm64.txt' -print -quit)"

IOS_AUDIT_DIR="$REPO_ROOT/ios_build/audit"
IPA_STAGE="$IOS_AUDIT_DIR/ipa-stage"
FINAL_IPA="$IOS_AUDIT_DIR/OpenLiveReplay-prepush.ipa"
rm -rf "$IOS_AUDIT_DIR"
mkdir -p "$IPA_STAGE/Payload"
cp -R "$APP_BUNDLE" "$IPA_STAGE/Payload/OpenLiveReplay.app"
(
    cd "$IPA_STAGE"
    zip -qry "$FINAL_IPA" Payload
)

python3 "$REPO_ROOT/build-scripts/audit_single_ffmpeg.py" \
    --package "$APP_BUNDLE" \
    --platform ios \
    --link-map "$LINK_MAP" \
    --archive "$REPO_ROOT/ios_build/xcframeworks/libavcodec.xcframework/ios-arm64/libavcodec.a" \
    --archive "$REPO_ROOT/ios_build/xcframeworks/libavformat.xcframework/ios-arm64/libavformat.a" \
    --archive "$REPO_ROOT/ios_build/xcframeworks/libavutil.xcframework/ios-arm64/libavutil.a" \
    --archive "$REPO_ROOT/ios_build/xcframeworks/libswscale.xcframework/ios-arm64/libswscale.a" \
    --archive "$REPO_ROOT/ios_build/xcframeworks/libswresample.xcframework/ios-arm64/libswresample.a" \
    --archive "$REPO_ROOT/ios_build/xcframeworks/libsrt.xcframework/ios-arm64/libsrt.a" \
    --final-package "$FINAL_IPA" \
    --evidence "$IOS_AUDIT_DIR/OpenLiveReplay-ios-evidence.json" \
    --spdx "$IOS_AUDIT_DIR/OpenLiveReplay-ios.spdx.json"

echo "[pre-push] iOS build and single-FFmpeg audit OK - push proceeding."
