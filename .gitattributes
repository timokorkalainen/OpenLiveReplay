# Shell scripts must keep LF line endings so they run under bash on every
# platform (CRLF breaks the shebang / `\r` leaks into commands). This matters
# in particular for a Windows checkout, where core.autocrlf=true would otherwise
# rewrite them to CRLF.
*.sh text eol=lf
.githooks/* text eol=lf

# These byte-for-byte benchmark snapshots are guarded by SHA-256 at configure
# time. Keep their checkout representation identical on every platform.
tests/perf/saved912gpuopscope.h text eol=lf
tests/perf/saved912preparedregistry.h text eol=lf
tests/perf/saved912preparedregistry.cpp text eol=lf

# Task-9 validates these compiler-capture fixtures byte-for-byte against a
# Windows MinGW manifest: the source is LF, while the captured `.ii` is CRLF.
tests/gpu/fixtures/task9_mingw_capture.cpp text eol=lf
tests/gpu/fixtures/task9_mingw_preprocessed.ii text eol=crlf
