{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "cmake",
      "label": "CMake: build app",
      "command": "build",
      "targets": ["OpenLiveReplay"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "detail": "Build the app target with the active CMake preset"
    },
    {
      "type": "cmake",
      "label": "CMake: build all (incl. tests)",
      "command": "build",
      "targets": ["all"],
      "group": "build",
      "problemMatcher": ["$gcc"],
      "detail": "Build everything, including the test suite (OLR_BUILD_TESTS)"
    },
    {
      "type": "process",
      "label": "CMake: run tests (ctest)",
      "command": "ctest",
      "args": ["--output-on-failure"],
      "options": { "cwd": "${command:cmake.buildDirectory}" },
      "windows": {
        "command": "python",
        "args": [
          "${workspaceFolder}/tools/run_ctest.py",
          "--test-dir",
          "${command:cmake.buildDirectory}",
          "--output-on-failure"
        ],
        "options": { "cwd": "${workspaceFolder}" }
      },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": [],
      "detail": "Run CTest in the active preset's build directory with the controlled Windows runtime"
    }
  ]
}
