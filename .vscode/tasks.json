{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "cmake",
      "label": "CMake: build app",
      "command": "build",
      "targets": ["OpenLiveReplay"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "detail": "Build the app target with the active CMake preset"
    },
    {
      "type": "process",
      "label": "OpenLiveReplay: start controlled Windows app",
      "command": "python",
      "args": [
        "${workspaceFolder}/tools/run_windows_app.py",
        "--build-dir",
        "${command:cmake.buildDirectory}",
        "--executable",
        "${command:cmake.launchTargetPath}"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "detail": "Start the Windows app with runtime roots from the active CMake cache"
    },
    {
      "type": "process",
      "label": "OpenLiveReplay: start controlled Windows QML-debug app",
      "command": "python",
      "args": [
        "${workspaceFolder}/tools/run_windows_app.py",
        "--build-dir",
        "${command:cmake.buildDirectory}",
        "--executable",
        "${command:cmake.launchTargetPath}",
        "--",
        "-qmljsdebugger=host:localhost,port:${command:qt-qml.debugPort},block,services:DebugMessages,QmlDebugger,V8Debugger"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "detail": "Start the Windows app with cache-derived runtime roots and QML debugging enabled"
    },
    {
      "type": "cmake",
      "label": "CMake: build all (incl. tests)",
      "command": "build",
      "targets": ["all"],
      "group": "build",
      "problemMatcher": ["$gcc"],
      "detail": "Build everything, including the test suite (OLR_BUILD_TESTS)"
    },
    {
      "type": "process",
      "label": "CMake: run tests (ctest)",
      "command": "ctest",
      "args": ["--output-on-failure"],
      "options": { "cwd": "${command:cmake.buildDirectory}" },
      "windows": {
        "command": "python",
        "args": [
          "${workspaceFolder}/tools/run_ctest.py",
          "--test-dir",
          "${command:cmake.buildDirectory}",
          "--output-on-failure"
        ],
        "options": { "cwd": "${workspaceFolder}" }
      },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": [],
      "detail": "Run CTest in the active preset's build directory with the controlled Windows runtime"
    }
  ]
}
